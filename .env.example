# Meta/Instagram App Configuration
# Get these from https://developers.facebook.com/
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Instagram OAuth Redirect URI
# For local development: http://localhost:3000/api/auth/instagram/callback
# For Railway: https://your-app.up.railway.app/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# PostgreSQL Database URL
# For local: postgresql://user:password@localhost:5432/dastyar_insta
# For Railway: provided by Railway PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/dastyar_insta

# App URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_at_least_32_chars

# Token encryption key - generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
